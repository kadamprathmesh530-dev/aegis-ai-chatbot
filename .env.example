# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret (Change this to a long random secret in production)
JWT_SECRET=super_secret_jwt_key_982347923847923847293847

# Designated Default Admin Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@chatbot.local
ADMIN_PASSWORD=Admin@123456

# Google OAuth (Web Client ID from Google Cloud Console)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aegis-ai-chatbot.onrender.com/api/auth/google/callback

# Google Gemini API Key (Optional: Server uses smart AI fallback if empty)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Tavily API Key (Required for live web search / Phase 3B web-search tool)
# Get a key from: https://tavily.com/
# Used by server/services/webSearch.js via @tavily/core.
TAVILY_API_KEY=

# NVIDIA API Key (Optional: primary chat provider Nemotron 3 Ultra via OpenAI-compatible API)
# Get a key from: https://build.nvidia.com/
NVIDIA_API_KEY=

# Default Weather Location (Optional: fallback location for weather queries when no city is specified)
DEFAULT_WEATHER_LOCATION=

